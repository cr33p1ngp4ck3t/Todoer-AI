# Local development: copy to .env and generate separate random secrets below.
DATABASE_URL=sqlite:///./todo.db
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional error tracking. Empty disables it; no request bodies or locals are sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional AI providers. Task management works without these keys.
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional social login. Register callbacks at /auth/oauth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Microsoft OAuth is not implemented; no Microsoft credentials are used.
