# Docker Compose local development only. Keep .env out of version control.
POSTGRES_PASSWORD=
SECRET_KEY=
SESSION_SECRET=
# Generate each value separately with:
# python -c "import secrets; print(secrets.token_hex(32))"
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional AI and OAuth integrations:
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional FastAPI exception reporting; empty disables it.
SENTRY_DSN=
# Frontend project DSN, embedded in the browser build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
