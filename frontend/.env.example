# API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Sentry project todo-nl/todo-frontend. Empty disables reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development
# Build-time source map upload only. Never expose this token to the browser.
SENTRY_AUTH_TOKEN=
